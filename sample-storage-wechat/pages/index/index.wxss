page {
    background: #f4f5fa;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}

.page {
    padding: 32rpx 28rpx 56rpx;
}

/* ---------- hero ---------- */

.hero {
    padding: 48rpx 24rpx 40rpx;
}

.hero-badge {
    display: inline-block;
    font-size: 20rpx;
    letter-spacing: 4rpx;
    color: #5b4fd6;
    background: rgba(91, 79, 214, 0.1);
    border: 1rpx solid rgba(91, 79, 214, 0.28);
    border-radius: 8rpx;
    padding: 6rpx 16rpx;
}

.hero-title {
    display: block;
    font-size: 52rpx;
    font-weight: 700;
    color: #1d2030;
    margin-top: 20rpx;
    letter-spacing: 1rpx;
}

.hero-sub {
    display: block;
    font-size: 24rpx;
    color: #8b8fa5;
    margin-top: 14rpx;
    letter-spacing: 2rpx;
}

/* ---------- card ---------- */

.card {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 28rpx;
    margin-top: 24rpx;
    box-shadow: 0 6rpx 24rpx rgba(29, 32, 48, 0.05);
}

.card-head {
    display: flex;
    align-items: flex-start;
}

.card-no {
    font-size: 44rpx;
    font-weight: 800;
    line-height: 1;
    color: rgba(91, 79, 214, 0.24);
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    margin-right: 20rpx;
    padding-top: 4rpx;
}

.card-head-text {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.card-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1d2030;
}

.card-desc {
    font-size: 22rpx;
    color: #9a9eb2;
    margin-top: 8rpx;
    line-height: 1.5;
}

.card-actions {
    margin-top: 24rpx;
}

.card-actions-row {
    display: flex;
    gap: 16rpx;
}

/* ---------- button ---------- */

.btn {
    background: linear-gradient(135deg, #6c5ce7 0%, #5b4fd6 100%);
    color: #ffffff;
    font-size: 26rpx;
    font-weight: 500;
    border-radius: 16rpx;
    padding: 0;
    height: 76rpx;
    line-height: 76rpx;
    border: none;
    flex: 1;
}

.btn::after {
    border: none;
}

.btn-s {
    height: 68rpx;
    line-height: 68rpx;
    font-size: 24rpx;
}

.btn-hover {
    opacity: 0.82;
    transform: translateY(2rpx);
}

.mini-btn {
    background: transparent;
    color: #8b8fa5;
    font-size: 22rpx;
    border: 1rpx solid rgba(29, 32, 48, 0.14);
    border-radius: 10rpx;
    height: 48rpx;
    line-height: 46rpx;
    padding: 0 20rpx;
    margin: 0;
}

.mini-btn::after {
    border: none;
}

.mini-btn-hover {
    background: rgba(29, 32, 48, 0.05);
}

/* ---------- console ---------- */

.console {
    margin-top: 32rpx;
    background: #17171f;
    border-radius: 24rpx;
    overflow: hidden;
    box-shadow: 0 8rpx 32rpx rgba(23, 23, 31, 0.25);
}

.console-head {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.console-dot-group {
    display: flex;
    align-items: center;
    margin-right: 16rpx;
}

.console-dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    margin-right: 8rpx;
}

.console-dot-r {
    background: #ff5f57;
}

.console-dot-y {
    background: #febc2e;
}

.console-dot-g {
    background: #28c840;
}

.console-title {
    flex: 1;
    font-size: 20rpx;
    color: #6f7385;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    letter-spacing: 1rpx;
}

.console-body {
    height: 480rpx;
    padding: 24rpx;
    box-sizing: border-box;
}

.console-text {
    display: block;
    font-size: 22rpx;
    line-height: 1.75;
    color: #c8ccdf;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    white-space: pre-line;
    word-break: break-all;
    width: 100%;
}

.console-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
}

.console-empty-text {
    font-size: 22rpx;
    color: #4b4f61;
}

/* ---------- foot ---------- */

.foot {
    margin-top: 32rpx;
    display: flex;
    justify-content: center;
}

.foot-text {
    font-size: 20rpx;
    color: #b0b3c2;
    text-align: center;
    line-height: 1.7;
}
